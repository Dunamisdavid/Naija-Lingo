// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lesson {
  id           String   @id @default(cuid())
  language     String
  sceneLabel   String
  context      String
  phrase       String
  question     String
  options      String[]
  correctIndex Int
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}